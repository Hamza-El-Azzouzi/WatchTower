# Copy this file to .env before starting Docker Compose.
# Use unique, randomly generated values outside local development.
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
ADMIN_JWT_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-12-character-password

# Browser-visible endpoints. Change these when the dashboard is not accessed locally.
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WS_URL=ws://localhost:8080
DASHBOARD_ORIGIN=http://localhost:3000

# Alert evaluation and built-in agent heartbeat alerting.
ALERT_CHECK_INTERVAL_SECONDS=5
AGENT_OFFLINE_AFTER_SECONDS=60
